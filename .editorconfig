# .editorconfig
root = true

[*]
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true

[*.{c,cc,cpp,h,hpp,hxx,inl,md,yml,yaml,txt}]
end_of_line = lf
indent_style = space
indent_size = 2

# Fișiere controlate mai natural de Visual Studio / Windows tooling
[*.{sln,vcxproj,vcxproj.filters,props,targets,bat,cmd}]
end_of_line = crlf